                            <path d="M 20 30 Q 15 15 10 10" stroke="#ef4444" stroke-width="3" fill="none" class="glow-red"/>
                            <text x="20" y="90" fill="#fca5a5" font-size="10">뾰족한 모서리 ➔ 손쉽게 잘 뜯어짐</text>
                            
                            <!-- Round sticker safe -->
                            <rect x="140" y="30" width="80" height="50" rx="15" fill="#334155" stroke="#10b981" stroke-width="2"/>
                            <text x="140" y="90" fill="#6ee7b7" font-size="10">둥근 모서리 ➔ 들뜸 없이 짱짱함</text>
