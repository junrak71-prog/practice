    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;

        document.getElementById('totalSlideNum').innerText = totalSlides;

        // Initialize Dots
        const dotsContainer = document.getElementById('slideDots');
        for (let i = 0; i < totalSlides; i++) {
            const dot = document.createElement('div');
            dot.className = `w-2.5 h-2.5 rounded-full transition-all cursor-pointer ${i === 0 ? 'bg-indigo-500 w-6' : 'bg-slate-700'}`;
            dot.onclick = () => goToSlide(i);
            dotsContainer.appendChild(dot);
        }

        function updateSlideUI() {
            slides.forEach((slide, index) => {
                if (index === currentSlide) {
                    slide.classList.add('active');
                } else {
                    slide.classList.remove('active');
                }
            });

            document.getElementById('currentSlideNum').innerText = currentSlide + 1;
            document.getElementById('prevBtn').disabled = currentSlide === 0;

            const nextBtn = document.getElementById('nextBtn');
            if (currentSlide === totalSlides - 1) {
                nextBtn.innerText = "처음으로 🔄";
            } else {
                nextBtn.innerText = "다음 슬라이드 ➡";
            }

            // Update dots
            const dots = dotsContainer.children;
            for (let i = 0; i < dots.length; i++) {
                if (i === currentSlide) {
                    dots[i].className = 'w-6 h-2.5 rounded-full bg-indigo-500 transition-all';
                } else {
                    dots[i].className = 'w-2.5 h-2.5 rounded-full bg-slate-700 transition-all';
                }
            }
        }

        function changeSlide(direction) {
            currentSlide += direction;
            if (currentSlide >= totalSlides) {
                currentSlide = 0;
            } else if (currentSlide < 0) {
                currentSlide = 0;
            }
            updateSlideUI();
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlideUI();
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'Space') {
                changeSlide(1);
            } else if (e.key === 'ArrowLeft') {
                changeSlide(-1);
            }
        });
    </script>
