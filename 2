                            <text x="60" y="50" fill="#34d399" font-size="10" font-weight="bold">✨ 완전 충전 (Void Zero)</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 6: Patent Ideas -->
        <div class="slide flex-col justify-center items-center text-left space-y-6 max-w-5xl mx-auto w-full">
